rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidDatasetId(id) {
      return id == 'compras' || id == 'servicos';
    }

    function isValidChunkId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // 2. Test Connection (Validação inicial de boot)
    match /test/connection {
      allow read: if true;
    }

    // 3. Coleção de Metadados de Datasets (Compras e Serviços)
    match /datasets/{datasetId} {
      allow read: if isValidDatasetId(datasetId);
      allow create, update, delete: if isValidDatasetId(datasetId);

      // 4. Subcoleção de Partições de Registros (Chunks)
      match /chunks/{chunkId} {
        allow read: if isValidDatasetId(datasetId) && isValidChunkId(chunkId);
        allow create, update, delete: if isValidDatasetId(datasetId) && isValidChunkId(chunkId);
      }
    }
  }
}
